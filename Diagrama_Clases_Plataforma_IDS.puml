@startuml
skinparam classAttributeIconSize 0
hide empty members
left to right direction

' --- Enumeraciones ---
enum UserType {
  ADMINISTRATOR
  REGULAR_USER
}

enum ContentType {
  EVENT
  FORUM
  BLOG
  NEWS
}

' --- Entidades Principales ---
class User {
  - name: String
  - username: String
  - email: String
  - type: UserType
  - externalAuthProvider: String
  - notificationsEnabled: Boolean
  + changeUsername(newUsername: String): Boolean
  + updateNotificationPreference(enabled: Boolean): void
}

abstract class Blog {
  - title: String
  - content: String
  - creationDate: LocalDateTime
  - expirationDate: LocalDate
  - isVisible: Boolean
  - viewCount: Integer
  - likeCount: Integer
  - publicationType: String
  - eventStartDate: LocalDateTime
  - eventEndDate: LocalDateTime
  - location: String
  - registrationUrl: String
  - imageUrls: List<String>
  + publishPost(): Boolean
  + editPost(title: String, content: String): Boolean
  + displayPost(): String
  + deletePost(): Boolean
  + hidePost(): Boolean
  + registerView(): void
  + registerLike(): void
}

' Herencia: El Foro es un tipo de Blog
class Forum {
  - comments: List<Comment>
  - lastActivityDate: LocalDateTime
  + displayComments(): List<Comment>
  + addComment(comment: Comment): Boolean
  + removeExpiredComments(currentDate: LocalDate): Integer
}

class Comment {
  - content: String
  - creationDate: LocalDateTime
  - likeCount: Integer
  - isHiddenByAuthor: Boolean
  - author: User
  - replies: List<Comment>
  + publishComment(): Boolean
  + hideComment(): Boolean
  + displayComment(): String
  + deleteComment(): Boolean
  + addReply(reply: Comment): Boolean
}

' --- Sistema de Notificaciones ---
abstract class Notification {
  - notificationTime: LocalDateTime
  - title: String
  - content: String
  - isRead: Boolean
  {abstract} + notify(recipient: User): Boolean
}

class SystemNotification {
  + notify(recipient: User): Boolean
  + displayInSystem(recipient: User): Boolean
}

' --- Capa de Servicios (Lógica de Negocio) ---
class Calendar {
  - semesterStartDate: LocalDate
  - semesterEndDate: LocalDate
  - events: List<Blog>
  + registerEvent(event: Blog): Boolean
  + editEvent(event: Blog): Boolean
  + hideEvent(event: Blog): Boolean
  + deleteEvent(event: Blog): Boolean
  + displayEvents(): List<Blog>
  + requestEventNotification(event: Blog, recipients: List<User>): void
}

class AuthManager {
  - emails: List<String>
  + addEmail(email: String): Boolean
  + removeEmail(email: String): Boolean
  + isEmailWhitelisted(email: String): Boolean
  + checkPermission(user: User): Boolean
}

' --- Relaciones ---

Blog <|-- Forum
Forum *-- Comment : contains

' Asociaciones de Propiedad/Acceso
User "1" --> "0..*" Blog : manages
User "1" --> "0..*" Comment : writes
User "1" --> "0..*" Notification : receives

' Relaciones de Servicio
Calendar "1" --> "0..*" Blog : manages event posts
Calendar -- AuthManager : validates permissions
Blog -- AuthManager : validates permissions
Forum -- AuthManager : validates permissions
Comment -- AuthManager : validates permissions



' Relaciones de Herencia Correctas
Notification <|-- SystemNotification

' --- Notas de Reglas de Negocio ---
note right of AuthManager
  Centraliza las reglas de acceso:
  - Validar si el usuario es ADMIN.
  - Controlar la Whitelist de emails.
  - Verificar permisos de edición/borrado.
end note

note right of Forum
  Reglas de Foro:
  - Usuarios pueden publicar comentarios.
  - Autores pueden ocultar(Se vera como eliminar) sus propios comentarios.
  - Admins pueden borrar cualquier comentario.
  - Expiración automática al final del bloque del semestre.
end note

@enduml